{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/parents-guide",
      "destination": "/parents-guide/index.html"
    },
    {
      "source": "/games",
      "destination": "/games/index.html"
    },
    {
      "source": "/games/:slug",
      "destination": "/games/:slug/index.html"
    },
    {
      "source": "/articles",
      "destination": "/articles/index.html"
    },
    {
      "source": "/articles/:slug",
      "destination": "/articles/:slug/index.html"
    },
    {
      "source": "/categories",
      "destination": "/categories/index.html"
    },
    {
      "source": "/categories/:slug",
      "destination": "/categories/:slug/index.html"
    },
    {
      "source": "/tools",
      "destination": "/tools/index.html"
    },
    {
      "source": "/tools/:slug",
      "destination": "/tools/:slug/index.html"
    },
    {
      "source": "/((?!assets|privacy|terms|about|contact|parents-guide|games|articles|categories|tools|.*\\..*).*)$",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/play",
      "destination": "/games",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "game",
          "value": "(?:piano|piano-tiles|magic-piano)"
        }
      ],
      "destination": "/piano",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "game",
          "value": "rhymes"
        }
      ],
      "destination": "/rhymes",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "game"
        }
      ],
      "destination": "/games",
      "permanent": false
    },
    {
      "source": "/games/magic-piano",
      "destination": "/piano",
      "permanent": true
    },
    {
      "source": "/games/piano-tiles",
      "destination": "/piano",
      "permanent": true
    },
    {
      "source": "/games/:legacy(aim-trainer|brick-breaker|bubble-shooter|builder-world|color-gate-arena|color-switch|connect-four|crossy-road|flap-hero|flappy-hero|four-in-a-line|fruit-slice|galaxy-defender|geo-dash|hop-and-cross|jetpack-raider|math-sprint|memory-match|moto-x3m|neon-maze-runner|neon-rhythm-run|pac-maze|rooftop-parkour|snake|space-invaders|stunt-biker|sudoku|tic-tac-toe|tunnel-dash|tunnel-rush|whack-a-mole)",
      "destination": "/games",
      "permanent": true
    },
    {
      "source": "/categories/:category*",
      "destination": "/games",
      "permanent": true
    }
  ]
}
