{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/parents-guide", "destination": "/parents-guide/index.html" },
    { "source": "/games", "destination": "/games/index.html" },
    { "source": "/games/:slug", "destination": "/games/:slug/index.html" },
    { "source": "/articles", "destination": "/articles/index.html" },
    { "source": "/articles/:slug", "destination": "/articles/:slug/index.html" },
    { "source": "/categories", "destination": "/categories/index.html" },
    { "source": "/categories/:slug", "destination": "/categories/:slug/index.html" },
    { "source": "/((?!assets|privacy|terms|about|contact|parents-guide|games|articles|categories|.*\\..*).*)$", "destination": "/index.html" }
  ]
}
